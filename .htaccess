# ============================================================
# .HTACCESS — Quản Lý Nhập Xuất Hàng Hóa
# ============================================================

Options -Indexes

# Block direct access to data folder
<FilesMatch "\.(json)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Backup chỉ được tải qua index.php sau khi xác thực
<FilesMatch "^backup_.*\.zip$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Protect config files
<FilesMatch "\.(php)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# Block archived PHP files from direct access
<FilesMatch "\.old[0-9]*\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Allow index.php only
DirectoryIndex index.php

# PWA assets
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddType application/javascript .js

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Rewrite rules (optional)
<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>
